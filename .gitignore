# Local environment and secrets
.env
.env.local
*.key
*.pem
*.pfx
*.p12

# Python virtual environment
.venv/
venv/
env/

# Python-generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# IDE configuration
.vscode/
.idea/

# Generated logs
logs/
*.log

# Generated parser outputs
output/
batch_temp/
temp/
tmp/

# Diagnostic input and processed data
Data/input/diagnostic_reports/*
Data/input/processed/*
Data/input/rejected/*
Data/input/failed/*

# Keep empty directory markers
!Data/input/diagnostic_reports/.gitkeep
!Data/input/processed/.gitkeep
!Data/input/rejected/.gitkeep
!Data/input/failed/.gitkeep

# Local database files and dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.backup

# Office temporary files
~$*
*.tmp

# Operating-system files
Thumbs.db
Desktop.ini
.DS_Store

# Power BI local temporary files
*.pbix.autosave