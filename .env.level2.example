# Existing PostgreSQL connection
PGHOST=localhost
PGPORT=5433
PGDATABASE=diagnostic_intelligence_test
PGUSER=postgres
PGPASSWORD=replace_with_local_password
PGCONNECT_TIMEOUT=10

# Approved local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=replace_with_1024_dimension_embedding_model
OLLAMA_CHAT_MODEL=qwen3:8b
EMBEDDING_DIMENSION=1024

# Retrieval controls
RAG_TOP_K=10
RAG_MAX_DISTANCE=0.65
RAG_APPROVED_ONLY=1
RAG_EVENT_WINDOW_SECONDS=30

# Knowledge input and output
KNOWLEDGE_JSONL=knowledge_samples/dummy_knowledge.jsonl
RAG_OUTPUT_DIR=output/rag
